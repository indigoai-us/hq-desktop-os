  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": [
      "ES2022"
    ],
    "types": [
      "node"
    ],
    "rootDir": "src",
    "noEmit": true
  },
  "include": [
    "src/preload/**/*.ts",
    "src/shared/**/*.ts"
  ]
}
