{
  "name": "hq-desktop-os",
  "version": "0.1.0-local.1",
  "private": true,
  "description": "HQ desktop companion for Windows and Linux",
  "license": "MIT",
  "main": "dist/main/index.js",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.12.0 <25",
    "pnpm": "10.28.2"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "dev:desktop": "pnpm build:main && pnpm build:preload && electron .",
    "build": "pnpm build:main && pnpm build:preload && pnpm build:renderer",
    "build:main": "tsc -p tsconfig.node.json",
    "build:preload": "vite build --config vite.preload.config.ts",
    "build:renderer": "vite build",
    "typecheck": "pnpm typecheck:main && pnpm typecheck:preload && pnpm typecheck:renderer && pnpm typecheck:tests",
    "typecheck:main": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:preload": "tsc -p tsconfig.preload.json --noEmit",
    "typecheck:renderer": "tsc -p tsconfig.app.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:electron": "playwright test --config playwright.electron.config.ts",
    "test:host-acceptance": "playwright test --config playwright.host-acceptance.config.ts",
    "stage:runtime": "node scripts/stage-runtime.mjs",
    "preview:prod": "vite preview --host 127.0.0.1 --port 4319 --strictPort",
    "test:acceptance": "pnpm test:e2e && pnpm test:electron",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit",
    "package:deb": "pnpm build && electron-builder --linux deb --x64 --publish never",
    "package:appimage": "pnpm build && electron-builder --linux AppImage --x64 --publish never"
  },
  "dependencies": {
    "@indigoai-us/hq-cloud": "6.16.35",
    "@tailwindcss/vite": "4.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.3.0",
    "radix-ui": "1.6.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@playwright/test": "1.58.1",
    "@types/jsdom": "21.1.7",
    "@types/node": "22.19.7",
    "@types/react": "19.2.9",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.2",
    "electron": "40.0.0",
    "electron-builder": "26.0.12",
    "eslint": "9.39.2",
    "globals": "17.0.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.53.1",
    "vite": "7.3.1",
    "vitest": "4.0.18"
  },
  "author": "HQ Desktop OS contributors",
  "homepage": "https://github.com/indigoai-us/hq-desktop-os",
  "build": {
    "appId": "computer.hq.desktop.os",
    "productName": "HQ Desktop OS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "LICENSE"
    ],
    "asar": true,
    "linux": {
      "executableName": "hq-desktop-os",
      "category": "Utility",
      "target": [
        "deb"
      ],
      "artifactName": "hq-desktop-os_${version}_${arch}.${ext}",
      "icon": "build/icon.png"
    },
    "deb": {
      "maintainer": "HQ Desktop OS contributors",
      "depends": [
        "libgtk-3-0",
        "libnss3",
        "libxss1",
        "libxtst6",
        "libatspi2.0-0",
        "libdrm2",
        "libgbm1",
        "libasound2",
        "libx11-xcb1"
      ]
    },
    "win": {
      "target": "nsis",
      "artifactName": "hq-desktop-os_${version}_windows.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    }
  }
}
