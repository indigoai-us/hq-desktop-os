{
  "name": "hq-desktop-os",
  "version": "0.1.0",
  "private": true,
  "description": "HQ desktop companion for Windows and Linux",
  "license": "MIT",
  "main": "dist/main/index.js",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.12.0 <25",
    "pnpm": "10.28.2"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "dev:desktop": "pnpm build:main && pnpm build:preload && electron .",
    "build": "pnpm build:main && pnpm build:preload && pnpm build:renderer",
    "build:main": "tsc -p tsconfig.node.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build:renderer": "vite build",
    "typecheck": "pnpm typecheck:main && pnpm typecheck:preload && pnpm typecheck:renderer",
    "typecheck:main": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:preload": "tsc -p tsconfig.preload.json --noEmit",
    "typecheck:renderer": "tsc -p tsconfig.app.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:electron": "playwright test --config playwright.electron.config.ts"
  },
  "dependencies": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@playwright/test": "1.58.1",
    "@types/node": "22.19.7",
    "@types/react": "19.2.9",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.2",
    "electron": "40.0.0",
    "eslint": "9.39.2",
    "globals": "17.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.53.1",
    "vite": "7.3.1",
    "vitest": "4.0.18"
  }
}
